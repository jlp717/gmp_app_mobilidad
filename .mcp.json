{
  "mcpServers": {
    "context7": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@upstash/context7-mcp@latest"],
      "autoStart": false
    },
    "guardvibe": {
      "command": "npx",
      "args": ["-y", "guardvibe@3.1.21"]
    },
    "ibm-db2": {
      "command": "npx",
      "args": ["-y", "ibm-db2-mcp"],
      "env": { "ODBC_DSN": "GMP" },
      "autoStart": false
    },
    "dart-flutter": {
      "command": "npx",
      "args": ["-y", "dart-flutter-mcp"],
      "autoStart": false
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "autoStart": false
    }
  }
}