{
  "version": 1,
  "description": "Gold cases from real OpenCode failure modes",
  "cases": [
    {
      "id": "gold-doom-loop-identical-tools",
      "source": "anti-doom-loop detections in .opencode/doom-loops/",
      "expect": { "status": "BLOCK", "code": "DOOM_LOOP_DETECTED" },
      "deterministic": true
    },
    {
      "id": "gold-max-iterations-critical",
      "source": "goal-loop overrun without completion_promise",
      "expect": { "status": "BLOCK", "code": "CRITICAL_ERROR", "reason": "max_iterations" },
      "deterministic": true
    },
    {
      "id": "gold-production-without-token",
      "source": "attempted prod mutation without production-approval-gate",
      "expect": { "status": "BLOCK", "gate": "production-approval-gate" },
      "deterministic": true
    },
    {
      "id": "gold-sandbox-ttl-over-30",
      "source": "sandbox-run with timeout_seconds>30 without allow_extended_ttl",
      "expect": { "status": "BLOCK", "rule": "sandbox_ttl" },
      "deterministic": true
    },
    {
      "id": "gold-worker-full-thread-forbidden",
      "source": "handoff with full_thread=true",
      "expect": { "status": "BLOCK", "rule": "context_isolation" },
      "deterministic": true
    },
    {
      "id": "gold-config-direct-write",
      "source": "chief write to .opencode/config without proposal",
      "expect": { "status": "BLOCK", "gate": "file-gate-check" },
      "deterministic": true
    }
  ]
}
