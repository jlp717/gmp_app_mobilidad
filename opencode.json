{
    "$schema":  "https://opencode.ai/config.json",
    "model":  "openai/gpt-5.5",
    "small_model":  "opencode-go/deepseek-v4-flash",
    "default_agent":  "chief-engineer-assistant",
    "username":  "Javier",
    "share":  "disabled",
    "autoupdate":  "notify",
    "snapshot":  false,
    "instructions":  [
                         ".opencode/AGENTS.md",
                         "AGENTS.md",
                         "CLAUDE.md"
                     ],
    "skills":  {
                   "paths":  [
                                 ".opencode/skills"
                             ]
               },
    "server":  {
                   "port":  3090,
                   "hostname":  "0.0.0.0",
                   "mdns":  false,
                   "cors":  [
                                "http://localhost:3090",
                                "http://100.107.11.80:3090",
                                "app://opencode.ai"
                            ]
               },
    "watcher":  {
                    "ignore":  [
                                   "node_modules/**",
                                   ".dart_tool/**",
                                   "build/**",
                                   ".next/**",
                                   ".swarm/**",
                                   ".opencode-runtime/**",
                                   ".opencode/snapshots/**",
                                   ".opencode/chromadb/**",
                                   ".beads/dolt/**",
                                   "**/*.log",
                                   ".git-rewrite/**"
                               ]
                },
    "tool_output":  {
                        "max_lines":  300,
                        "max_bytes":  20000
                    },
    "compaction":  {
                       "auto":  true,
                       "prune":  true,
                       "reserved":  30000,
                       "tail_turns":  8
                   },
    "enabled_providers":  [
                              "openai",
                              "cursor-acp",
                              "opencode-go",
                              "opencode"
                          ],
    "disabled_providers":  [
                               "nvidia",
                               "google",
                               "amazon-bedrock"
                           ],
    "experimental":  {
                         "mcp_timeout":  30000,
                         "policies":  [
                                          {
                                              "effect":  "deny",
                                              "action":  "provider.use",
                                              "resource":  "*"
                                          },
                                          {
                                              "effect":  "allow",
                                              "action":  "provider.use",
                                              "resource":  "openai"
                                          },
                                          {
                                              "effect":  "allow",
                                              "action":  "provider.use",
                                              "resource":  "cursor-acp"
                                          },
                                          {
                                              "effect":  "allow",
                                              "action":  "provider.use",
                                              "resource":  "opencode-go"
                                          },
                                          {
                                              "effect":  "allow",
                                              "action":  "provider.use",
                                              "resource":  "opencode"
                                          }
                                      ]
                     },
    "permission":  {
                       "read":  {
                                    "*":  "allow",
                                    "*.env":  "deny",
                                    "*.env.*":  "deny",
                                    "*.pem":  "deny",
                                    "*.key":  "deny"
                                },
                       "edit":  {
                                    "*":  "ask"
                                },
                       "bash":  {
                                    "*":  "ask",
                                    "git status*":  "allow",
                                    "git diff*":  "allow",
                                    "git log*":  "allow",
                                    "bd ready*":  "allow"
                                },
                       "external_directory":  "ask",
                       "doom_loop":  "ask",
                       "skill":  {
                                     "*":  "allow"
                                 },
                       "lsp":  "allow"
                   },
    "plugin":  [
                   "./.opencode/plugins/model-fallback-forward.ts",
                   "./.opencode/plugins/flow-observability.ts",
                   "./.opencode/plugins/execution-visibility.ts",
                   "./.opencode/plugins/env-protection.ts",
                   "./.opencode/plugins/context-compaction.ts",
                   "./.opencode/plugins/task-tracer.ts",
                   "./.opencode/plugins/anti-hallucination-guard.ts",
                   "./.opencode/plugins/rate-limit-handler.ts",
                   "./.opencode/plugins/anti-doom-loop.ts",
                   "./.opencode/plugins/mobile-mode-detector.ts",
                   "./.opencode/plugins/same-error-detector.ts",
                   "./.opencode/plugins/production-safety-guard.ts",
                   "./.opencode/plugins/user-correction-capture.ts"
               ],
    "tools":  {
                  "voice-synthesis":  true,
                  "rag-query":  true,
                  "staging-deploy":  true,
                  "tech-radar-fetch":  true,
                  "retrospective-trigger":  true,
                  "github-advanced":  true,
                  "parallel-dispatch":  true,
                  "file-gate-check":  true,
                  "metrics-push":  true,
                  "production-approval-gate":  true,
                  "elite-quality-gate":  true,
                  "decision-router":  true,
                  "agent-roster-audit":  true,
                  "flow-policy-check":  true,
                  "team-curator-report":  true,
                  "model-assignment-audit":  true,
                  "workflow-state-audit":  true,
                  "plan-approval-gate":  true,
                  "readiness-smoke":  true,
                  "correction-capture":  true,
                  "handoff-ledger":  true,
                  "daily-digest-summary":  true,
                  "model-provider-health":  true,
                  "flow-status":  true,
                  "flow-trace":  true
              },
    "command":  {
                    "quality":  {
                                    "description":  "Ejecuta el gate de calidad senior sobre cambios actuales.",
                                    "agent":  "chief-engineer-assistant",
                                    "template":  "Ejecuta elite-quality-gate y corrige o delega cualquier bloqueo. Argumentos: $ARGUMENTS"
                                },
                    "route":  {
                                  "description":  "Calcula tier, agentes, MCPs, gates y evidencias antes de ejecutar una peticion.",
                                  "agent":  "chief-engineer-assistant",
                                  "template":  "Ejecuta prompt-optimizer y decision-router sobre esta peticion. No implementes todavia; devuelve ruta, riesgos, gates y evidencias: $ARGUMENTS"
                              },
                    "flow-check":  {
                                       "description":  "Valida la ruta V4 contra politicas de agentes, MCPs, skills, gates y evidencias.",
                                       "agent":  "chief-engineer-assistant",
                                       "template":  "Ejecuta flow-policy-check sobre la ruta actual o task_id. Si hay BLOCK, corrige la ruta antes de delegar. Argumentos: $ARGUMENTS"
                                   },
                    "classify":  {
                                     "description":  "Clasifica una peticion sin ejecutar: workflow, riesgo, modelo, autonomia y verificacion.",
                                     "agent":  "chief-engineer-assistant",
                                     "template":  "Ejecuta prompt-optimizer, decision-router y flow-policy-check sin implementar. Devuelve classification, agentes, MCPs, gates y stop_conditions: $ARGUMENTS"
                                 },
                    "route-eval":  {
                                       "description":  "Ejecuta escenarios de regresion del decision-router.",
                                       "agent":  "chief-engineer-assistant",
                                       "template":  "Ejecuta decision-router con self_test=true. Si falla, no implementes nada y muestra diferencias: $ARGUMENTS"
                                   },
                    "team-curator":  {
                                         "description":  "Genera reporte curador semanal del equipo y opcionalmente lo envia a Telegram.",
                                         "agent":  "team-curator",
                                         "template":  "Ejecuta team-curator-report. Si ARGUMENTS contiene telegram, envia resumen a Telegram. Argumentos: $ARGUMENTS"
                                     },
                    "model-audit":  {
                                        "description":  "Audita modelos pinneados por agente y fallback policy.",
                                        "agent":  "team-curator",
                                        "template":  "Ejecuta model-assignment-audit. Si hay BLOCK, no ejecutes Tier 2/3 hasta corregirlo. Argumentos: $ARGUMENTS"
                                    },
                    "state-audit":  {
                                        "description":  "Audita maquina de estados, transiciones y gates de aprobacion.",
                                        "agent":  "team-curator",
                                        "template":  "Ejecuta workflow-state-audit. Si hay BLOCK, no ejecutes Tier 2/3 hasta corregirlo. Argumentos: $ARGUMENTS"
                                    },
                    "approve-plan":  {
                                         "description":  "Aprueba explicitamente el plan de una tarea antes de editar codigo.",
                                         "agent":  "chief-engineer-assistant",
                                         "template":  "Ejecuta plan-approval-gate con action=approve para el task_id indicado. Solo acepta frases como \u0027apruebo el plan\u0027 o \u0027adelante con el plan\u0027. Argumentos: $ARGUMENTS"
                                     },
                    "readiness":  {
                                      "description":  "Smoke test barato de proveedores, Cursor, MCPs, skills, tools, comandos y ultimo preflight.",
                                      "agent":  "team-curator",
                                      "template":  "Ejecuta readiness-smoke. Si hay BLOCK, no inicies Tier 2/3 hasta corregirlo. Argumentos: $ARGUMENTS"
                                  },
                    "flow":  {
                                 "description":  "Muestra ejecucion reciente: tools, errores, fallback y salud de proveedores.",
                                 "agent":  "chief-engineer-assistant",
                                 "template":  "Ejecuta flow-status con limit=20. Si ARGUMENTS trae session_id, filtra por esa sesion. Resume en lenguaje claro que se ejecuto y si hay fallback activo."
                             },
                    "models":  {
                                   "description":  "Estado de fallback de modelos y proveedores bloqueados.",
                                   "agent":  "chief-engineer-assistant",
                                   "template":  "Ejecuta model-provider-health. Si ARGUMENTS trae un agente, pasalo como agent. Explica modelo efectivo y bloqueos activos."
                               },
                    "trace":  {
                                  "description":  "Resumen legible paso a paso del flujo reciente (fases, tools, modelos).",
                                  "agent":  "chief-engineer-assistant",
                                  "template":  "Ejecuta flow-trace mode=summary limit=20. Si ARGUMENTS trae session_id, filtralo. Explica que se ejecuto en lenguaje claro."
                              },
                    "teach":  {
                                  "description":  "Guarda una correccion de Javier como memoria prioritaria.",
                                  "agent":  "chief-engineer-assistant",
                                  "template":  "Ejecuta correction-capture con correction_text=$ARGUMENTS, source=slash:/teach y severity=correction. Confirma en una frase que queda guardado."
                              },
                    "workflow":  {
                                     "description":  "Ejecuta o inspecciona el flujo V4 faseado con state, TEAM_TRACE y gates.",
                                     "agent":  "chief-engineer-assistant",
                                     "template":  "Aplica el flujo V4 completo con prompt-optimizer, decision-router, autonomous-flow, state y TEAM_TRACE. Argumentos: $ARGUMENTS"
                                 },
                    "verify":  {
                                   "description":  "Verifica cambios con QA, AppSec, SRE, elite-quality-gate y evidencia de release.",
                                   "agent":  "qa-automation-lead",
                                   "template":  "Ejecuta verificacion integral segun decision-router y autonomous-flow. Argumentos: $ARGUMENTS"
                               },
                    "voice":  {
                                  "description":  "Activa o desactiva modo voz Chief Engineer.",
                                  "agent":  "chief-engineer-assistant",
                                  "template":  "Gestiona modo voz con los argumentos: $ARGUMENTS"
                              },
                    "simulate":  {
                                     "description":  "Simula carga, picos, failover o latencia contra staging.",
                                     "agent":  "sre-engineer",
                                     "template":  "Ejecuta simulacion segura con argumentos: $ARGUMENTS"
                                 },
                    "digest":  {
                                   "description":  "Genera Daily Digest manual.",
                                   "agent":  "chief-engineer-assistant",
                                   "template":  "Ejecuta daily-digest-summary. Devuelve solo el resumen operativo accionable; no uses N/A, no Telegram salvo que ARGUMENTS lo pida explicitamente. Argumentos: $ARGUMENTS"
                               },
                    "retro":  {
                                  "description":  "Lanza o consulta retrospectivas.",
                                  "agent":  "sre-engineer",
                                  "template":  "Gestiona retrospectiva con argumentos: $ARGUMENTS"
                              },
                    "adelante":  {
                                     "description":  "Confirma promocion a produccion durante una ventana auditada.",
                                     "agent":  "chief-engineer-assistant",
                                     "template":  "Gestiona confirmacion de produccion con argumentos: $ARGUMENTS"
                                 }
                },
    "mcp":  {
                "context7-local":  {
                                       "enabled":  true,
                                       "type":  "local",
                                       "command":  [
                                                   "C:/nvm4w/nodejs/context7-mcp.cmd"
                                               ],
                                       "timeout":  30000
                                   },
                "ddg-search":  {
                                   "enabled":  true,
                                   "type":  "local",
                                   "command":  [
                                                   "C:/nvm4w/nodejs/duckduckgo-mcp-server.cmd"
                                               ],
                                   "timeout":  30000
                               },
                "fetch-local":  {
                                    "enabled":  true,
                                    "type":  "local",
                                    "command":  [
                                                   "C:/nvm4w/nodejs/fetch-mcp.cmd"
                                               ],
                                    "timeout":  30000
                                },
                "git-local":  {
                                  "enabled":  true,
                                  "type":  "local",
                                  "command":  [
                                                   "C:/nvm4w/nodejs/git-mcp-server.cmd"
                                               ],
                                  "timeout":  30000
                              },
                "beads":  {
                              "enabled":  true,
                              "type":  "local",
                              "command":  [
                                              "C:/Users/Javier/AppData/Local/Programs/Python/Python311/Scripts/beads-mcp.exe"
                                          ],
                              "timeout":  30000
                          },
                "memory":  {
                               "enabled":  true,
                               "type":  "local",
                               "command":  [
                                               "C:/nvm4w/nodejs/mcp-server-memory.cmd"
                                           ],
                               "timeout":  30000
                           },
                "sequential-thinking":  {
                                            "enabled":  true,
                                            "type":  "local",
                                            "command":  [
                                                            "C:/nvm4w/nodejs/mcp-server-sequential-thinking.cmd"
                                                        ],
                                            "timeout":  30000
                                        },
                "dart-flutter-mcp":  {
                                         "enabled":  false,
                                         "type":  "local",
                                         "command":  [
                                                         "C:/flutter/bin/dart.bat",
                                                         "mcp-server"
                                                     ],
                                         "timeout":  30000
                                     },
                "pub-mcp":  {
                                "enabled":  true,
                                "type":  "local",
                                "command":  [
                                                "C:/nvm4w/nodejs/pub-mcp.cmd",
                                                "--stdio"
                                            ],
                                "timeout":  30000
                            },
                "ibm-db2-mcp":  {
                                    "type":  "local",
                                    "command":  [
                                                    "C:\\Program Files\\nodejs\\node.exe",
                                                    "C:/Users/Javier/Desktop/Repositorios/gmp_app_mobilidad/scripts/opencode/mcp/ibm-odbc-mcp.cjs"
                                                ],
                                    "environment":  {
                                                        "ODBC_DSN":  "GMP",
                                                        "ODBC_SCHEMA":  "JAVIER"
                                                    },
                                    "enabled":  true,
                                    "timeout":  30000,
                                    "env":  {
                                                "ODBC_DSN":  "GMP",
                                                "ODBC_SCHEMA":  "JAVIER"
                                            }
                                },
                "gmp-deploy-ssh":  {
                                       "type":  "local",
                                       "command":  [
                                                       "C:\\Program Files\\nodejs\\node.exe",
                                                       "C:/Users/Javier/Desktop/Repositorios/gmp_app_mobilidad/scripts/opencode/mcp/gmp-deploy-ssh-mcp.cjs"
                                                   ],
                                       "environment":  {
                                                           "SSH_GMP_HOST":  "192.168.1.230",
                                                           "SSH_GMP_USER":  "gmp"
                                                       },
                                       "enabled":  true,
                                       "timeout":  30000
                                   },
                "playwright":  {
                                   "enabled":  true,
                                   "type":  "local",
                                   "command":  [
                                                   "C:/nvm4w/nodejs/playwright-mcp.cmd"
                                               ],
                                   "timeout":  30000
                               },
                "chrome-devtools":  {
                                        "enabled":  true,
                                        "type":  "local",
                                        "command":  [
                                                   "C:/nvm4w/nodejs/chrome-devtools-mcp.cmd"
                                               ],
                                        "timeout":  30000
                                    },
                "github":  {
                               "enabled":  true,
                               "type":  "local",
                               "command":  [
                                               "C:/nvm4w/nodejs/mcp-server-github.cmd"
                                           ],
                               "environment":  {
                                                   "GITHUB_TOKEN":  "${env.GITHUB_TOKEN}"
                                               },
                               "timeout":  30000
                           },
                "firecrawl":  {
                                  "enabled":  false,
                                  "type":  "local",
                                  "command":  [
                                                   "C:/nvm4w/nodejs/firecrawl-mcp.cmd"
                                               ],
                                  "timeout":  30000
                              },
                "sentry":  {
                               "enabled":  false,
                               "type":  "local",
                               "command":  [
                                                   "C:/nvm4w/nodejs/mcp-server-sentry.cmd"
                                               ],
                               "timeout":  30000
                           },
                "filesystem":  {
                                   "enabled":  false,
                                   "type":  "local",
                                   "command":  [
                                                   "C:/nvm4w/nodejs/mcp-server-filesystem.cmd"
                                               ],
                                   "timeout":  30000
                               }
            },
    "provider":  {
                     "openai":  {
                                    "options":  {
                                                    "timeout":  600000,
                                                    "chunkTimeout":  60000
                                                },
                                    "models":  {
                                                   "gpt-5.5":  {
                                                                   "options":  {
                                                                                   "reasoningEffort":  "high",
                                                                                   "textVerbosity":  "low",
                                                                                   "reasoningSummary":  "auto"
                                                                               },
                                                                   "variants":  {
                                                                                    "medium":  {
                                                                                                   "reasoningEffort":  "medium",
                                                                                                   "textVerbosity":  "low",
                                                                                                   "reasoningSummary":  "auto"
                                                                                               },
                                                                                    "high":  {
                                                                                                 "reasoningEffort":  "high",
                                                                                                 "textVerbosity":  "low",
                                                                                                 "reasoningSummary":  "auto"
                                                                                             },
                                                                                    "xhigh":  {
                                                                                                  "reasoningEffort":  "high",
                                                                                                  "textVerbosity":  "low",
                                                                                                  "reasoningSummary":  "auto"
                                                                                              }
                                                                                }
                                                               }
                                               }
                                },
                     "opencode":  {
                                      "models":  {
                                                     "deepseek-v4-flash-free":  {
                                                                                    "name":  "DeepSeek V4 Flash Free"
                                                                                },
                                                     "mimo-v2.5-free":  {
