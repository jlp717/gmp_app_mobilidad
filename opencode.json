{
  "$schema": "https://opencode.ai/config.schema.json",
  "project": {
    "name": "GMP App Mobilidad",
    "description": "App de movilidad comercial GMP — Flutter + Node.js + IBM DB2/AS400"
  },
  "agents": {
    "dir": ".opencode/agents",
    "count": 41,
    "new_agents": ["mcp-tool-miner", "memory-cleaner"]
  },
  "config": {
    "dir": ".opencode/config",
    "files": [
      "chief-protocol.yaml",
      "model-routing.yaml",
      "task-classification.yaml",
      "workflow-state-machine.yaml",
      "autonomous-flow.yaml",
      "handoff-contract.yaml",
      "orchestrator-decision-tree.yaml",
      "runtime-health.yaml",
      "hybrid-interaction.yaml",
      "goal-loops.yaml",
      "learning-loop.yaml",
      "production-safety.yaml",
      "response-verification.yaml",
      "mobile-mode.yaml",
      "mobile-productivity.yaml",
      "context-compaction.yaml",
      "model-update-policy.yaml",
      "security-gate.yaml",
      "telegram-hitl-gateway.yaml",
      "semantic-memory-pruner.yaml",
      "automation-schedule.json",
      "daily-digest.yaml",
      "github-watchlist.yaml",
      "team-curator.yaml",
      "tech-radar.yaml",
      "fallback-models.json"
    ]
  },
  "memory": {
    "dir": ".opencode/memory"
  },
  "state": {
    "dir": ".opencode/state",
    "key_files": [
      "session-cost-accumulator.json",
      "provider-health.json",
      "model-routing-live.json",
      "same-error-counts.json"
    ]
  },
  "rules": ".opencode/rules.json",
  "fallback_models": ".opencode/fallback-models.json",
  "skills": {
    "dir": ".opencode/skills"
  },
  "plugins": {
    "dir": ".opencode/plugins"
  },
  "proposals": {
    "dir": ".opencode/proposals",
    "flow": "telegram-hitl-gateway"
  },
  "mcp": {
    "configured": ["ibm-db2-mcp", "gmp-deploy-ssh", "context7", "ddg-search", "fetch", "github", "memory", "sequential-thinking", "time", "pub-mcp", "playwright", "chrome-devtools"],
    "config_file": ".opencode/mcp.json"
  },
  "workflow_states": {
    "standard": ["INTAKE", "ROUTED", "DISCOVERY", "PLAN_READY", "WAITING_PLAN_APPROVAL", "WAITING_CLARIFICATION", "IMPLEMENTING", "GOAL_LOOPING", "VERIFYING", "STAGING", "WAITING_PRODUCTION_APPROVAL", "PRODUCTION_DEPLOY", "REPORTING", "BLOCKED", "DONE"],
    "advanced": ["CONTEXT_COMPACTION", "COLD_STORAGE", "WAITING_FOR_USER_APPROVAL", "EXECUTE_APPROVED_CHANGE", "PROPOSAL_REJECTED"]
  },
  "automation": {
    "schedule_file": ".opencode/config/automation-schedule.json",
    "jobs": ["tech_radar", "github_watchlist", "mcp_tool_miner", "model_catalog", "model_update_proposer", "daily_digest", "team_curator", "morning_briefing", "state_cleanup", "memory_garbage_collector"]
  }
}
