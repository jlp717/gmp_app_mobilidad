                                       "description":  "Agrupa errores repetidos y genera retro accionable en Obsidian.",
                                       "agent":  "sre-engineer",
                                       "template":  "Ejecuta retro-auto max_groups=5 notify_telegram=false. Devuelve grupos y acciones."
                                   },
                    "briefing":  {
                                     "description":  "Briefing corto para movil/Telegram con estado, riesgos y siguiente accion.",
                                     "agent":  "chief-engineer-assistant",
                                     "template":  "Ejecuta mobile-briefing send_telegram=false save_obsidian=true. Si ARGUMENTS contiene telegram, usa send_telegram=true."
                                 },
