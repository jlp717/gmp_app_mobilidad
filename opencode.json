                  "team-curator-report":  true,
                  "model-assignment-audit":  true,
                  "workflow-state-audit":  true,
                  "plan-approval-gate":  true,
                  "readiness-smoke":  true,
                  "correction-capture":  true,
                  "handoff-ledger":  true,
                  "daily-digest-summary":  true,
                  "model-provider-health":  true,
                  "flow-status":  true,
                  "flow-trace":  true,
                  "mobile-ops-status":  true,
                  "repo-intake-gate":  true,
                  "mobile-autopilot":  true,
                  "continuous-improvement-loop":  true,
                  "mobile-safety-net":  true,
                  "obsidian-capture":  true,
                  "team-ci":  true,
                  "team-backup":  true,
                  "retro-auto":  true,
                  "mobile-briefing":  true,
                  "model-roster-view":  true,
                  "autonomous-capability-audit":  true,
                  "honors-grade-audit":  true,
                  "goal-loop-manager":  true,
                  "clarification-gate":  true,
                  "scheduled-automation-runner":  true,
                  "github-watchlist-sync":  true,
                  "model-catalog-watch":  true,
                  "state-cleanup":  true
              },
    "command":  {
                    "quality":  {
                                    "description":  "Ejecuta el gate de calidad senior sobre cambios actuales.",
                                    "agent":  "chief-engineer-assistant",
                                    "template":  "Ejecuta elite-quality-gate y corrige o delega cualquier bloqueo. Argumentos: $ARGUMENTS"
                                },
                    "route":  {
                                  "description":  "Calcula tier, agentes, MCPs, gates y evidencias antes de ejecutar una peticion.",
                                  "agent":  "chief-engineer-assistant",
                                  "template":  "Ejecuta prompt-optimizer y decision-router sobre esta peticion. No implementes todavia; devuelve ruta, riesgos, gates y evidencias: $ARGUMENTS"
                              },
                    "flow-check":  {
                                       "description":  "Valida la ruta V4 contra politicas de agentes, MCPs, skills, gates y evidencias.",
                                       "agent":  "chief-engineer-assistant",
                                       "template":  "Ejecuta flow-policy-check sobre la ruta actual o task_id. Si hay BLOCK, corrige la ruta antes de delegar. Argumentos: $ARGUMENTS"
                                   },
                    "classify":  {
                                     "description":  "Clasifica una peticion sin ejecutar: workflow, riesgo, modelo, autonomia y verificacion.",
                                     "agent":  "chief-engineer-assistant",
                                     "template":  "Ejecuta prompt-optimizer, decision-router y flow-policy-check sin implementar. Devuelve classification, agentes, MCPs, gates y stop_conditions: $ARGUMENTS"
                                 },
                    "route-eval":  {
                                       "description":  "Ejecuta escenarios de regresion del decision-router.",
                                       "agent":  "chief-engineer-assistant",
                                       "template":  "Ejecuta decision-router con self_test=true. Si falla, no implementes nada y muestra diferencias: $ARGUMENTS"
                                   },
                    "team-curator":  {
                                         "description":  "Genera reporte curador semanal del equipo y opcionalmente lo envia a Telegram.",
                                         "agent":  "team-curator",
                                         "template":  "Ejecuta team-curator-report. Si ARGUMENTS contiene telegram, envia resumen a Telegram. Argumentos: $ARGUMENTS"
                                     },
                    "model-audit":  {
                                        "description":  "Audita modelos pinneados por agente y fallback policy.",
                                        "agent":  "team-curator",
                                        "template":  "Ejecuta model-assignment-audit. Si hay BLOCK, no ejecutes Tier 2/3 hasta corregirlo. Argumentos: $ARGUMENTS"
                                    },
                    "state-audit":  {
                                        "description":  "Audita maquina de estados, transiciones y gates de aprobacion.",
                                        "agent":  "team-curator",
                                        "template":  "Ejecuta workflow-state-audit. Si hay BLOCK, no ejecutes Tier 2/3 hasta corregirlo. Argumentos: $ARGUMENTS"
                                    },
                    "approve-plan":  {
                                         "description":  "Aprueba explicitamente el plan de una tarea antes de editar codigo.",
                                         "agent":  "chief-engineer-assistant",
                                         "template":  "Ejecuta plan-approval-gate con action=approve para el task_id indicado. Solo acepta frases como \u0027apruebo el plan\u0027 o \u0027adelante con el plan\u0027. Argumentos: $ARGUMENTS"
                                     },
                    "readiness":  {
                                      "description":  "Smoke test barato de proveedores, Cursor, MCPs, skills, tools, comandos y ultimo preflight.",
                                      "agent":  "team-curator",
                                      "template":  "Ejecuta readiness-smoke. Si hay BLOCK, no inicies Tier 2/3 hasta corregirlo. Argumentos: $ARGUMENTS"
                                  },
                    "flow":  {
                                 "description":  "Muestra ejecucion reciente: tools, errores, fallback y salud de proveedores.",
                                 "agent":  "chief-engineer-assistant",
                                 "template":  "Ejecuta flow-status con limit=20. Si ARGUMENTS trae session_id, filtra por esa sesion. Resume en lenguaje claro que se ejecuto y si hay fallback activo."
                             },
                    "models":  {
                                   "description":  "Estado de fallback de modelos y proveedores bloqueados.",
                                   "agent":  "chief-engineer-assistant",
                                   "template":  "Ejecuta model-provider-health. Si ARGUMENTS trae un agente, pasalo como agent. Explica modelo efectivo y bloqueos activos."
                               },
                    "trace":  {
                                  "description":  "Resumen legible paso a paso del flujo reciente (fases, tools, modelos).",
                                  "agent":  "chief-engineer-assistant",
                                  "template":  "Ejecuta flow-trace mode=summary limit=20. Si ARGUMENTS trae session_id, filtralo. Explica que se ejecuto en lenguaje claro."
                              },
                    "teach":  {
                                  "description":  "Guarda una correccion de Javier como memoria prioritaria.",
                                  "agent":  "chief-engineer-assistant",
                                  "template":  "Ejecuta correction-capture con correction_text=$ARGUMENTS, source=slash:/teach y severity=correction. Confirma en una frase que queda guardado."
                              },
                    "workflow":  {
                                     "description":  "Ejecuta o inspecciona el flujo V4 faseado con state, TEAM_TRACE y gates.",
                                     "agent":  "chief-engineer-assistant",
                                     "template":  "Aplica el flujo V4 completo con prompt-optimizer, decision-router, autonomous-flow, state y TEAM_TRACE. Argumentos: $ARGUMENTS"
                                 },
                    "verify":  {
                                   "description":  "Verifica cambios con QA, AppSec, SRE, elite-quality-gate y evidencia de release.",
                                   "agent":  "qa-automation-lead",
                                   "template":  "Ejecuta verificacion integral segun decision-router y autonomous-flow. Argumentos: $ARGUMENTS"
                               },
                    "voice":  {
                                  "description":  "Activa o desactiva modo voz Chief Engineer.",
                                  "agent":  "chief-engineer-assistant",
                                  "template":  "Gestiona modo voz con los argumentos: $ARGUMENTS"
                              },
                    "simulate":  {
                                     "description":  "Simula carga, picos, failover o latencia contra staging.",
                                     "agent":  "sre-engineer",
                                     "template":  "Ejecuta simulacion segura con argumentos: $ARGUMENTS"
                                 },
                    "digest":  {
                                   "description":  "Genera Daily Digest manual.",
                                   "agent":  "chief-engineer-assistant",
                                   "template":  "Ejecuta daily-digest-summary. Devuelve solo el resumen operativo accionable; no uses N/A, no Telegram salvo que ARGUMENTS lo pida explicitamente. Argumentos: $ARGUMENTS"
                               },
                    "retro":  {
                                  "description":  "Lanza o consulta retrospectivas.",
                                  "agent":  "sre-engineer",
                                  "template":  "Gestiona retrospectiva con argumentos: $ARGUMENTS"
                              },
                    "ponytail":  {
                                     "description":  "Activa criterio senior minimalista: YAGNI, stdlib/nativo primero y menor diff correcto.",
                                     "agent":  "chief-engineer-assistant",
                                     "template":  "Aplica Ponytail con nivel ARGUMENTS (lite/full/ultra/off; full si vacio). Antes de escribir codigo, cuestiona YAGNI, stdlib, nativo, dependencia existente y menor diff correcto. Argumentos: $ARGUMENTS"
                                 },
                    "ponytail-review":  {
                                            "description":  "Revisa cambios solo por sobreingenieria y oportunidades de borrar codigo.",
                                            "agent":  "chief-engineer-assistant",
                                            "template":  "Usa la skill ponytail-review sobre los cambios actuales. Solo complejidad: delete, stdlib, native, yagni, shrink. No corrijas bugs aqui. Argumentos: $ARGUMENTS"
                                        },
                    "ponytail-audit":  {
                                           "description":  "Audita el repo completo para detectar sobreingenieria, bloat y dependencias evitables.",
                                           "agent":  "team-curator",
                                           "template":  "Usa la skill ponytail-audit sobre el repositorio completo. Devuelve acciones rankeadas para subir el score del equipo. Argumentos: $ARGUMENTS"
                                       },
                    "ponytail-debt":  {
                                          "description":  "Recolecta marcadores inline ponytail: deuda tecnica intencional y triggers de upgrade.",
                                          "agent":  "team-curator",
                                          "template":  "Usa la skill ponytail-debt y resume marcadores, riesgos sin trigger y acciones pendientes. Argumentos: $ARGUMENTS"
                                      },
                    "adelante":  {
                                     "description":  "Confirma promocion a produccion durante una ventana auditada.",
                                     "agent":  "chief-engineer-assistant",
                                     "template":  "Gestiona confirmacion de produccion con argumentos: $ARGUMENTS"
                                 },
                    "mobile-status":  {
                                          "description":  "Estado operativo corto para usar desde movil: Web, Cursor ACP, readiness, proveedores, trazas y git dirty.",
                                          "agent":  "chief-engineer-assistant",
                                          "template":  "Ejecuta mobile-ops-status detail=false. Devuelve mobile_summary y acciones concretas. Argumentos: $ARGUMENTS"
                                      },
                    "rescue":  {
                                   "description":  "Rescate remoto bajo demanda: diagnostica Web/Cursor/readiness/proveedores/trazas y propone la siguiente accion segura.",
                                   "agent":  "chief-engineer-assistant",
                                   "template":  "Ejecuta mobile-ops-status detail=true, flow-status limit=20, model-provider-health y readiness-smoke. Si hay BLOCK, prioriza restaurar acceso remoto y no toques produccion. Argumentos: $ARGUMENTS"
                               },
                    "ops":  {
                                "description":  "Panel operativo compacto: salud, runtime, trazas y bloqueos sin ruido.",
                                "agent":  "chief-engineer-assistant",
                                "template":  "Ejecuta mobile-ops-status detail=true y flow-trace mode=summary limit=20. Devuelve estado ejecutivo para movil. Argumentos: $ARGUMENTS"
                            },
                    "radar":  {
                                  "description":  "Busca novedades externas accionables: repos recientes, MCPs, agents, releases y herramientas AI para mejorar el equipo.",
                                  "agent":  "tech-radar-agent",
                                  "template":  "Ejecuta tech-radar-fetch con sources github_recent,mcp_registry,awesome_copilot,github_trending,hn max_items_per_source=8. Devuelve maximo 8 items con accion: EVALUAR/OBSERVAR/DESCARTAR. No instales nada. Argumentos: $ARGUMENTS"
                              },
                    "repo-check":  {
                                       "description":  "Evalua un repo de GitHub encontrado en Twitter antes de instalarlo o integrarlo.",
                                       "agent":  "tech-radar-agent",
                                       "template":  "Ejecuta repo-intake-gate con url=$ARGUMENTS. Devuelve PASS/WARN/BLOCK, riesgos, licencia, mantenimiento, relevancia y siguiente paso seguro. No instales nada."
                                   },
                    "autopilot":  {
                                      "description":  "Autopilot operativo para movil: salud, fallback, ruta efectiva y siguiente accion segura.",
                                      "agent":  "chief-engineer-assistant",
                                      "template":  "Ejecuta mobile-autopilot mode=status. Si hay DEGRADED_READY, explica el modelo efectivo y como reintentar sin diagnostico manual. Argumentos: $ARGUMENTS"
                                  },
                    "failover":  {
                                     "description":  "Fuerza o limpia failover de proveedores desde movil.",
                                     "agent":  "chief-engineer-assistant",
                                     "template":  "Si ARGUMENTS contiene openai, ejecuta mobile-autopilot mode=mark-openai-down reason=$ARGUMENTS. Si contiene clear, ejecuta mobile-autopilot mode=clear-provider-blocks. Luego muestra rutas efectivas y siguiente reintento seguro."
                                 },
                    "improve":  {
                                    "description":  "Loop de mejora continua: readiness, fallback, errores repetidos, radar y acciones priorizadas.",
                                    "agent":  "team-curator",
                                    "template":  "Ejecuta continuous-improvement-loop include_radar=true max_actions=8. Devuelve P0/P1/P2 y no instales nada externo sin repo-check y sandbox. Argumentos: $ARGUMENTS"
                                },
                    "safety":  {
                                   "description":  "Safety net movil: bloqueos operativos antes de Tier 2/3, produccion o tareas serias.",
                                   "agent":  "chief-engineer-assistant",
                                   "template":  "Ejecuta mobile-safety-net strict=false. Si devuelve BLOCK, no inicies Tier 2/3 y ejecuta /rescue o la accion indicada. Argumentos: $ARGUMENTS"
                               },
