                                     "description":  "Guarda una decision, runbook, retro, radar o nota en el vault local de Obsidian.",
                                     "agent":  "chief-engineer-assistant",
                                     "template":  "Ejecuta obsidian-capture. Usa kind=inbox salvo que ARGUMENTS indique decision/runbook/retro/radar/team. No guardes secretos. Argumentos: $ARGUMENTS"
                                 },
                    "team-ci":  {
                                    "description":  "CI completo del equipo antes de trabajo serio desde movil.",
                                    "agent":  "team-curator",
                                    "template":  "Ejecuta team-ci include_agnix=true notify_telegram=false. Si BLOCK, no iniciar Tier 2/3. Argumentos: $ARGUMENTS"
                                },
                    "backup-team":  {
                                        "description":  "Backup local restaurable de configuracion OpenCode del equipo.",
                                        "agent":  "chief-engineer-assistant",
                                        "template":  "Ejecuta team-backup label=$ARGUMENTS y resume ruta del backup."
                                    },
