{
    "$schema":  "https://opencode.ai/config.json",
    "model":  "openai/gpt-5.5",
    "small_model":  "opencode-go/deepseek-v4-flash",
    "default_agent":  "chief-engineer-assistant",
    "username":  "Javier",
    "share":  "disabled",
    "autoupdate":  "notify",
    "snapshot":  false,
    "instructions":  [
                         ".opencode/config/chief-protocol.yaml",
                         ".opencode/config/mobile-productivity.yaml",
                         ".opencode/AGENTS.md",
                         "AGENTS.md",
                         "CLAUDE.md"
                     ],
    "skills":  {
                   "paths":  [
                                 ".opencode/skills"
                             ]
               },
    "server":  {
                   "port":  3090,
                   "hostname":  "0.0.0.0",
                   "mdns":  false,
                   "cors":  [
                                "http://localhost:3090",
                                "http://100.107.11.80:3090",
                                "app://opencode.ai"
                            ]
               },
    "watcher":  {
                    "ignore":  [
                                   "node_modules/**",
                                   ".dart_tool/**",
                                   "build/**",
                                   ".next/**",
                                   ".swarm/**",
                                   ".opencode-runtime/**",
                                   ".opencode/snapshots/**",
                                   ".opencode/chromadb/**",
                                   ".beads/dolt/**",
                                   "**/*.log",
                                   ".git-rewrite/**"
                               ]
                },
    "tool_output":  {
                        "max_lines":  300,
                        "max_bytes":  20000
                    },
    "compaction":  {
                       "auto":  true,
                       "prune":  true,
                       "reserved":  30000,
                       "tail_turns":  8
                   },
    "enabled_providers":  [
                              "openai",
                              "cursor-acp",
                              "opencode-go",
                              "opencode"
                          ],
    "disabled_providers":  [
                               "nvidia",
                               "google",
                               "amazon-bedrock"
                           ],
    "experimental":  {
                         "mcp_timeout":  30000,
                         "policies":  [
                                          {
                                              "effect":  "deny",
                                              "action":  "provider.use",
                                              "resource":  "*"
                                          },
                                          {
                                              "effect":  "allow",
                                              "action":  "provider.use",
                                              "resource":  "openai"
                                          },
                                          {
                                              "effect":  "allow",
                                              "action":  "provider.use",
                                              "resource":  "cursor-acp"
                                          },
                                          {
                                              "effect":  "allow",
                                              "action":  "provider.use",
                                              "resource":  "opencode-go"
                                          },
                                          {
                                              "effect":  "allow",
                                              "action":  "provider.use",
                                              "resource":  "opencode"
                                          }
                                      ]
                     },
    "permission":  {
                       "read":  {
                                    "*":  "allow",
                                    "*.env":  "deny",
                                    "*.env.*":  "deny",
                                    "*.pem":  "deny",
                                    "*.key":  "deny"
                                },
                       "edit":  {
                                    "*":  "ask"
                                },
                       "bash":  {
                                    "*":  "ask",
                                    "git status*":  "allow",
                                    "git diff*":  "allow",
                                    "git log*":  "allow",
                                    "bd ready*":  "allow"
                                },
                       "external_directory":  "ask",
                       "doom_loop":  "ask",
                       "skill":  {
                                     "*":  "allow"
                                 },
                       "lsp":  "allow"
                   },
    "plugin":  [
                   "./.opencode/plugins/model-fallback-forward.ts",
                   "./.opencode/plugins/flow-observability.ts",
                   "./.opencode/plugins/execution-visibility.ts",
                   "./.opencode/plugins/env-protection.ts",
                   "./.opencode/plugins/context-compaction.ts",
                   "./.opencode/plugins/session-resilience.ts",
                   "./.opencode/plugins/session-lifecycle.ts",
                   "./.opencode/plugins/goal-loop-idle-hint.ts",
                   "./.opencode/plugins/task-tracer.ts",
                   "./.opencode/plugins/anti-hallucination-guard.ts",
                   "./.opencode/plugins/rate-limit-handler.ts",
                   "./.opencode/plugins/anti-doom-loop.ts",
                   "./.opencode/plugins/mobile-mode-detector.ts",
                   "./.opencode/plugins/same-error-detector.ts",
                   "./.opencode/plugins/production-safety-guard.ts",
                   "./.opencode/plugins/user-correction-capture.ts",
                   "file:///C:/Users/Javier/.config/opencode/ponytail/.opencode/plugins/ponytail.mjs"
               ],
    "tools":  {
                  "voice-synthesis":  true,
                  "telegram-notify":  true,
                  "rag-query":  true,
                  "memory-save":  true,
                  "staging-deploy":  true,
                  "snapshot-create":  true,
                  "snapshot-restore":  true,
                  "tech-radar-fetch":  true,
                  "retrospective-trigger":  true,
                  "github-advanced":  true,
                  "parallel-dispatch":  true,
                  "file-gate-check":  true,
                  "metrics-push":  true,
                  "production-approval-gate":  true,
