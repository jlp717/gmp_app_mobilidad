[Unit]
Description=GMP RAG Indexer - Re-indexa codebase en ChromaDB
After=chromadb.service network.target
Requires=chromadb.service

[Service]
User=gmp
WorkingDirectory=/opt/gmp-tools
ExecStart=/usr/bin/python3 /opt/gmp-tools/rag-indexer.py
Environment=GMP_ROOT=/opt/gmp-api
Environment=GRANJA_ROOT=/var/www/mari-pepa
EnvironmentFile=/opt/gmp-tools/.env
StandardOutput=journal
StandardError=journal
Restart=no

[Install]
WantedBy=multi-user.target
