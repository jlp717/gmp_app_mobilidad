[Unit]
Description=GMP ElevenLabs Bridge - Proxy local para sintesis de voz
After=network.target

[Service]
User=gmp
WorkingDirectory=/opt/gmp-tools
ExecStart=/usr/bin/python3 /opt/gmp-tools/elevenlabs-bridge.py
EnvironmentFile=/opt/gmp-tools/.env
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
