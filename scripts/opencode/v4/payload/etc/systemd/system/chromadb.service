[Unit]
Description=ChromaDB vector store for GMP OpenCode RAG
After=network.target

[Service]
User=gmp
WorkingDirectory=/opt/gmp-tools
ExecStart=/home/gmp/.local/bin/chroma run --host 0.0.0.0 --port 8000 --path /opt/gmp-tools/chromadb
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
