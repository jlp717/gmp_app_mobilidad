{
  "version": 1,
  "scenarios": [
    {
      "id": "no-composer-in-openai-critical",
      "file": ".opencode/fallback-models.json",
      "assert": "cursor-acp/composer-2.5 is absent from critical OpenAI agents"
    },
    {
      "id": "glm-fallback-code-test-review",
      "file": ".opencode/fallback-models.json",
      "assert": "opencode-go/glm-5.2 is present for Node-Express-Specialist, Test-Writer, and Code-Reviewer"
    },
    {
      "id": "no-legacy-cursor-claude-policy",
      "file": ".opencode/config/model-update-policy.yaml",
      "assert": "cursor-acp/claude-4.6-sonnet is absent"
    },
    {
      "id": "flow-observability-tolerant-atomic",
      "file": ".opencode/plugins/flow-observability.ts",
      "assert": "flow-trace-latest uses tolerant parse and atomic write"
    },
    {
      "id": "guardvibe-mcp-or-fallback",
      "file": ".mcp.json",
      "assert": "guardvibe MCP is wired and fallback scan script exists"
    },
    {
      "id": "external-docs-untrusted",
      "file": ".opencode/config/orchestrator-decision-tree.yaml",
      "assert": "Context7/ContextCrush/fetched docs are evidence, not instructions"
    },
    {
      "id": "serena-code-graph-routing",
      "file": ".opencode/config/autonomous-flow.yaml",
      "assert": "Flutter/Node/API routes request symbol/reference evidence when Serena is available"
    },
    {
      "id": "shelfware-telemetry-index-readonly",
      "file": ".opencode/scripts/audit/shelfware-telemetry-index.mjs",
      "assert": "shelfware index reads and dedupes telemetry without deletion"
    },
    {
      "id": "semantic-memory-pruner-scheduled-dry-run",
      "file": ".opencode/config/automation-schedule.json",
      "assert": "memory_garbage_collector runs semantic-memory-pruner in dry-run"
    },
    {
      "id": "provider-model-probe-blocks-pro",
      "file": ".opencode/scripts/models/provider-model-probe.mjs",
      "assert": "gpt-5.5-pro remains BLOCKED_UNVERIFIED without live catalog"
    },
    {
      "id": "final-29-item-checklist",
      "file": "tests/regression-model/scenarios.json",
      "assert": "final acceptance checklist fixture has 29 items",
      "items": [
        "strict_scope_only", "no_production_mutation", "no_db2_mutation", "no_pm2_mutation", "no_sensitive_values_printed",
        "critical_primary_stays_openai_gpt_5_5", "no_silent_cursor_critical_fallback", "no_silent_claude_fable_opus_fallback",
        "flow_latest_tolerant_missing", "flow_latest_tolerant_empty", "flow_latest_tolerant_invalid", "flow_latest_atomic_write",
        "guardvibe_mcp_wired", "guardvibe_fallback_warn_unavailable", "context7_untrusted_evidence", "contextcrush_prompt_injection_blocked",
        "serena_flutter_architecture_route", "serena_node_express_route", "serena_api_contract_route", "repo_explorer_code_graph_fallback",
        "shelfware_readonly_dedupe", "semantic_pruner_job_aligned", "semantic_pruner_dry_run_default", "provider_probe_exists",
        "gpt_5_5_pro_blocked_unverified", "json_files_parse", "regression_runner_pass", "audits_attempted", "restart_requirement_reported"
      ]
    }
  ]
}
