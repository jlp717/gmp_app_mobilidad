# GMP test profile: live ERP reads, isolated JAVIER.TEST_* writes.
# Copy the APP_ENV line into the protected runtime environment. Credentials
# remain deployment-managed environment references and never belong in Git.
APP_ENV=test
# ODBC_DSN, ODBC_UID and ODBC_PWD must be injected by the protected
# deployment environment; do not copy credentials into this file.

# Dry routing check: npm run env:verify -- --no-db
# Read-only DB2 catalog check: npm run env:verify
