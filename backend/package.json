{
  "name": "gmp-app-unified-backend",
  "version": "2.0.0",
  "description": "Backend API para GMP App Unified - Granja Mari Pepa (Optimized)",
  "main": "server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "api": "ts-node src/api-server.ts",
    "build": "tsc",
    "build:ts": "tsc",
    "start": "node server.js",
    "rollback": "bash scripts/tools/rollback.sh",
    "db:optimize": "node scripts/apply-db-optimizations.js",
    "start:pm2": "pm2 start ecosystem.config.js",
    "start:cluster": "pm2 start ecosystem.config.js -i max",
    "stop": "pm2 stop ecosystem.config.js",
    "restart": "pm2 restart ecosystem.config.js",
    "explore": "node db_explorer.js",
    "lint": "eslint src/**/*.ts --quiet",
    "test": "jest --passWithNoTests --forceExit",
    "test:targeted": "jest --runInBand --forceExit",
    "test:ci": "jest --ci --runInBand --forceExit",
    "test:coverage": "jest --coverage --passWithNoTests --forceExit",
    "test:watch": "jest --watch",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "optimize:pipeline": "node scripts/fullOptimizationPipeline.js",
    "optimize:validate": "node scripts/validation/pre-post-validator.js validate",
    "optimize:baseline": "node scripts/validation/pre-post-validator.js baseline",
    "optimize:chaos": "node scripts/testing/chaos-engineering.js all",
    "optimize:rollback": "node scripts/rollback-manager.js rollback",
    "cache:cleanup": "node scripts/cache-cleanup.js",
    "finance:cleanup": "node scripts/tools/cleanup-repartidor-finance-test-data.js",
    "finance:inventory-db": "node scripts/tools/repartidor_finance_db_inventory.js",
    "pedidos:inventory-reparto": "node scripts/tools/truck_route_driver_inventory.js",
    "pedidos:inventory-system": "node scripts/tools/pedidos_system_inventory.js",
    "db2:align-javier-dsedac": "node scripts/tools/compare-javier-dsedac-alignment.js",
    "db2:align-pedidos-schema": "node scripts/tools/generate-pedidos-schema-align-sql.js",
    "db2:audit-commercial-cobros": "node scripts/tools/audit-commercial-cobros-readonly.js",
    "db2:align-javier-dsedac:additive": "node scripts/tools/align-javier-dsedac-additive.js",
    "db2:align-javier-dsedac:apply": "node scripts/tools/align-javier-dsedac-additive.js --apply",
    "finance:verify-schema": "node scripts/tools/verify-repartidor-finance-schema.js",
    "flutter:test": "node scripts/flutterTestRunner.js"
  },
  "dependencies": {
    "@sentry/node": "^10.62.0",
    "@types/multer": "^2.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@whiskeysockets/baileys": "^6.7.18",
    "axios": "^1.18.1",
    "basic-ftp": "^5.2.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "joi": "^17.13.8",
    "js-yaml": "^4.3.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.11.0",
    "multer": "^2.4.0",
    "node-schedule": "^2.1.1",
    "nodemailer": "^9.1.1",
    "odbc": "^2.5.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "redis": "^4.6.11",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.11.0",
    "ws": "^8.16.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.10.5",
    "@types/node-schedule": "^2.1.8",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config@1.1.0": {
      "js-yaml": "3.15.2"
    },
    "form-data": "^4.0.6",
    "minimatch@^9.0.0": "9.0.9",
    "tar": "^7.5.19"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "author": "Granja Mari Pepa",
  "license": "UNLICENSED"
}
