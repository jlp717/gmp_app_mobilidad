# GMP production profile starts fail-closed: application buffers remain in
# JAVIER and APP_ENV alone enables neither ERP export nor production writes.
APP_ENV=production
# ODBC_DSN, ODBC_UID and ODBC_PWD must be injected by the protected
# deployment environment; do not copy credentials into this file.

# First run the read-only check. Production mutations additionally require the
# existing reviewed approval flags and the external PROD gate; they are
# intentionally absent from this template.
# Dry routing check: npm run env:verify -- --no-db
# Read-only DB2 catalog check: npm run env:verify
