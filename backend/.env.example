# GMP Backend — environment template (copy to .env and fill values)

# Server
NODE_ENV=development
PORT=3335
HOST=0.0.0.0

# DB2 ODBC (DSN must exist on host)
ODBC_UID=
ODBC_PWD=
# Data profiles:
# - PILOTO/dev: keep approval/export flags false; app writes stay in JAVIER.
# - STAGING/PRODUCCION: keep DB2_WRITE_SCHEMA=JAVIER; set PEDIDOS_DSEDAC_STORAGE_APPROVED=true,
#   PEDIDOS_EXPORT_TO_SYSTEM=true and PEDIDOS_DSEDAC_EXPORT_APPROVED=true after gates.
#   PEDIDOS_DSEDAC_STORAGE_APPROVED is an export approval gate here, not permission to use DSEDAC app buffers.
# DSEDAC export writes explicit ERP tables (CPC/LPC/CRC); do not use DSEDAC app-buffer copies by default.
DB2_READ_SCHEMA=DSEDAC
DB2_WRITE_SCHEMA=JAVIER
PEDIDOS_DSEDAC_STORAGE_APPROVED=false
PEDIDOS_EXPORT_TO_SYSTEM=false
PEDIDOS_DSEDAC_EXPORT_APPROVED=false

# JWT (generate: openssl rand -hex 32)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=24h
JWT_REFRESH_EXPIRES=7d

# Asistente GMP Chatbot — Groq hosts Llama models
# Primary names (recommended):
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Aliases also supported:
# LLAMA_API_KEY=
# LLAMA_MODEL=llama-3.3-70b-versatile

# Redis (optional)
REDIS_URL=redis://localhost:6379

# CORS (comma-separated origins in production)
CORS_ORIGINS=http://localhost:8081
