# GMP Backend — environment template (copy to .env and fill values)

# Server
NODE_ENV=test
PORT=3335
HOST=0.0.0.0

# DB2 ODBC (DSN must exist on host)
ODBC_DSN=GMP
ODBC_UID=
ODBC_PWD=
# Data profiles:
# - PILOTO/dev: keep approval/export flags false; app writes stay in JAVIER.
# - STAGING/PRODUCCION: keep DB2_WRITE_SCHEMA=JAVIER; set PEDIDOS_DSEDAC_STORAGE_APPROVED=true,
#   PEDIDOS_EXPORT_TO_SYSTEM=true and PEDIDOS_DSEDAC_EXPORT_APPROVED=true after gates.
#   PEDIDOS_DSEDAC_STORAGE_APPROVED is an export approval gate here, not permission to use DSEDAC app buffers.
# DSEDAC export writes explicit ERP tables (CPC/LPC/CRC); do not use DSEDAC app-buffer copies by default.
DB2_READ_SCHEMA=DSEDAC
DB2_WRITE_SCHEMA=JAVIER
PEDIDOS_DSEDAC_STORAGE_APPROVED=false
PEDIDOS_EXPORT_TO_SYSTEM=false
PEDIDOS_DSEDAC_EXPORT_APPROVED=false

# Reparto runtime (fail-closed)
# Allowed: test, staging, production. Missing/unknown values block writes.
REPARTO_ENVIRONMENT=test
# test/staging require isolated_test; production requires production.
# This is the only table-selection toggle.
REPARTO_TABLE_SET=isolated_test
# Fail-closed startup gate: true is reserved for future isolated tests;
# no migration callback is wired by this flag.
REPARTO_STARTUP_REPARTO_MIGRATIONS=false
# Pending evidence lifetime, required and bounded to 1..168 hours.
REPARTO_EVIDENCE_PENDING_TTL_HOURS=24
REPARTO_WRITES_ENABLED=false
# This is an operational gate, never a replacement for Javier + QA/AppSec/SRE approval.
REPARTO_PRODUCTION_WRITES_APPROVED=false
# Separate capability required before reparto may write ERP-owned DSEDAC tables in production.
# It never replaces the production approval, staging, QA, AppSec, SRE or Javier gates.
REPARTO_PRODUCTION_ERP_WRITES_APPROVED=false
# Enables only the isolated canonical DB2 confirmation capability after its schema/QA gates.
# Keep false until the evidence ownership transaction port and test schema are approved.
REPARTO_CONFIRMATION_DB2_CAPABILITY_APPROVED=false
# Separate production confirmation gate. Requires production writes and the
# capability flag above; it never authorizes DSEDAC writes or replaces human gates.
REPARTO_PRODUCTION_CONFIRMATION_APPROVED=false
# Enables finance DB2 capability only after its tables, transaction ports and QA gates.
# Independent from confirmation capability; it defaults to denied in every environment.
REPARTO_FINANCE_DB2_CAPABILITY_APPROVED=false
# Route moves and GPS tracking stay disabled until SQL 040/041 are
# preflighted, provisioned and verified for the selected DB2 table set.
REPARTIDOR_DAY_MOVE_ENABLED=false
REPARTIDOR_TRACKING_ENABLED=false
REPARTIDOR_FINANCE_READ_SCHEMA=DSEDAC
REPARTIDOR_FINANCE_APP_SCHEMA=JAVIER
REPARTIDOR_FINANCE_ERP_SCHEMA=JAVIER
# Exactly one route family: TS=true requires DDD=false; default canonical mode is DDD.
USE_TS_ROUTES=false
USE_DDD_ROUTES=true

# Optional aliases are accepted only when they equal the canonical values above.
# DB2_READ_SCHEMA=DSEDAC
# DB2_WRITE_SCHEMA=JAVIER
# PEDIDOS_CONFIRMATION_SCHEMA=JAVIER

# JWT (generate: openssl rand -hex 32)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=24h
JWT_REFRESH_EXPIRES=7d
# Production default rejects plaintext legacy PIN auth.
# Temporarily set both only during a controlled DB2 PIN-hash migration window.
AUTH_ALLOW_PLAINTEXT_PIN=false
AUTH_PLAINTEXT_PIN_AUTH_UNTIL=

# Asistente GMP Chatbot — Groq hosts Llama models
# Primary names (recommended):
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Aliases also supported:
# LLAMA_API_KEY=
# LLAMA_MODEL=llama-3.3-70b-versatile

# Redis (optional)
REDIS_URL=redis://localhost:6379

# CORS (comma-separated origins in production; CORS_ORIGINS is accepted only as a legacy alias)
CORS_ORIGIN=http://localhost:8081


# G4 TESTMOVIL (Director D-G4): write whitelist TESTMOVIL only. Never JAVIER/DSEDAC writes.
# REPARTO_TABLE_SET=testmovil
# REPARTIDOR_FINANCE_READ_SCHEMA=TESTMOVIL
# REPARTIDOR_FINANCE_APP_SCHEMA=TESTMOVIL
# REPARTIDOR_FINANCE_ERP_SCHEMA=TESTMOVIL
# REPARTO_FINANCE_DB2_CAPABILITY_APPROVED=true
# REPARTO_WRITES_ENABLED=true
