@@ -0,0 +1,12 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:gmp_app_mobilidad/features/repartidor/data/reparto_receipt_contract.dart';
+
+void main() {
+  test('only a single concrete owner is accepted', () {
+    expect(isValidRepartoOwnerId('R01'), isTrue);
+    expect(isValidRepartoOwnerId('ALL'), isFalse);
+    expect(isValidRepartoOwnerId('R01,R02'), isFalse);
+    expect(isValidRepartoOwnerId(''), isFalse);
+  });
+}

