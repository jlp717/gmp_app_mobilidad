++++ b/test/features/repartidor/repartidor_panel_collections_truth_test.dart
+@@
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:gmp_app_mobilidad/features/repartidor/presentation/pages/repartidor_panel_page.dart';
+import 'package:gmp_app_mobilidad/features/repartidor_finanzas/domain/repartidor_finanzas_models.dart';
+
+void main() {
+  RepartidorMonthlySummary finance() => RepartidorMonthlySummary(
+        repartidorId: '08',
+        period: RepartidorFinancialPeriod(year: 2026, month: 8),
+        totalCobrado: 10,
+        totalLiquidado: 0,
+        saldoPendiente: 0,
+        cobrosCount: 1,
+        liquidacionesCount: 0,
+      );
+
+  test('daily collections preserves PARTIAL and pending', () {
+    final response = RepartidorDailyCollections.fromJson({
+      'collectionAvailability': 'PARTIAL',
+      'daily': [
+        {'day': 1, 'date': '2026-08-01', 'collectable': 20, 'collected': 10, 'pending': 10, 'collectionAvailability': 'PARTIAL'},
+      ],
+    });
+    expect(response.isPartial, isTrue);
+    expect(response.daily.single.pending, 10);
+  });
+
+  testWidgets('panel makes PARTIAL collections visible and non-definitive', (tester) async {
+    await tester.pumpWidget(MaterialApp(
+      home: RepartidorPanelPage(
+        repartidorId: '08,09',
+        deliverySummaryLoader: ({required repartidorId, required year, required month}) async => {'summary': {}, 'daily': []},
+        monthlySummaryLoader: ({required repartidorId, required year, required month}) async => finance(),
+        dailyCollectionsLoader: ({required repartidorId, required year, required month}) async => RepartidorDailyCollections.fromJson({
+          'collectionAvailability': 'PARTIAL',
+          'daily': [
+            {'day': 1, 'date': '2026-08-01', 'collectable': 20, 'collected': 10, 'pending': 10, 'collectionAvailability': 'PARTIAL'},
+          ],
+        }),
+      ),
+    ));
+    await tester.pumpAndSettle();
+    expect(find.text('Datos parciales'), findsOneWidget);
+    expect(find.textContaining('no son un total definitivo'), findsOneWidget);
+    expect(find.text('Cobros diarios'), findsOneWidget);
+    expect(find.text('PARCIAL — no usar como cierre definitivo'), findsOneWidget);
+  });
+}

