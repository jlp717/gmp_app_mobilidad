diff --git a/backend/src/chatbot/chatbot_authorization.js b/backend/src/chatbot/chatbot_authorization.js
--- a/backend/src/chatbot/chatbot_authorization.js
+++ b/backend/src/chatbot/chatbot_authorization.js
@@ -21,0 +22,31 @@
+function authorizeRepartoScope(userContext = {}, requestedScope) {
+  const requested = normalizeCode(requestedScope);
+  const role = normalizeCode(userContext.role);
+  const activeMode = normalizeCode(userContext.activeMode || userContext.active_mode);
+  const own = normalizeCode(userContext.repartidorId || userContext.codigoConductor || userContext.userCode);
+  const allowed = [...new Set((Array.isArray(userContext.repartidorCodes)
+    ? userContext.repartidorCodes : String(userContext.repartidorCodes || '').split(','))
+    .map(normalizeCode).filter(Boolean))];
+  if (!requested) return { allowed: true, code: 'NO_REPARTO_SCOPE', driverCodes: [] };
+  if (requested.includes('BOLA')) return { allowed: false, code: 'REPARTO_SCOPE_FORBIDDEN' };
+  if (role === 'REPARTIDOR') {
+    return requested === own
+      ? { allowed: true, code: 'REPARTO_SCOPE_SELF', driverCodes: [own] }
+      : { allowed: false, code: 'REPARTO_SCOPE_FORBIDDEN' };
+  }
+  if (role !== 'JEFE_VENTAS' || activeMode !== 'REPARTIDOR') {
+    return { allowed: false, code: 'REPARTO_SCOPE_FORBIDDEN' };
+  }
+  if (requested === 'ALL') {
+    return allowed.length
+      ? { allowed: true, code: 'REPARTO_SCOPE_AGGREGATE', driverCodes: allowed }
+      : { allowed: false, code: 'REPARTO_SCOPE_UNVERIFIED' };
+  }
+  return allowed.includes(requested)
+    ? { allowed: true, code: 'REPARTO_SCOPE_SELECTED', driverCodes: [requested] }
+    : { allowed: false, code: 'REPARTO_SCOPE_FORBIDDEN' };
+}
+
