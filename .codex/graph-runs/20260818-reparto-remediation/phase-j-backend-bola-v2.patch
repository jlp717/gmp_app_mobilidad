diff --git a/backend/__tests__/reparto-bola-route-contract.test.js b/backend/__tests__/reparto-bola-route-contract.test.js
new file mode 100644
--- /dev/null
+++ b/backend/__tests__/reparto-bola-route-contract.test.js
@@ -0,0 +1,41 @@
+'use strict';
+
+const fs = require('fs');
+const path = require('path');
+
+describe('BOLA reparto fail-closed route contract', () => {
+  const read = (file) => fs.readFileSync(path.join(__dirname, '..', file), 'utf8');
+
+  test('pendientes rejects ALL, BOLA and CSV before selector sanitization', () => {
+    const source = read('routes/entregas.js');
+    expect(source).toContain("raw !== 'ALL' && raw !== 'BOLA' && !raw.includes(',')");
+    expect(source.indexOf('isStrictRepartidorSelector(repartidorId)'))
+      .toBeLessThan(source.indexOf('sanitizeCodeListForParams(repartidorId)'));
+  });
+
+  test('single driver routes and finance detail reject BOLA/ALL/CSV selectors', () => {
+    expect(read('routes/repartidor.js')).toContain('/^(ALL|BOLA)$/i');
+    const finance = read('routes/repartidor-finanzas.js');
+    expect(finance).toContain("codes.length !== 1 || codes.includes('BOLA')");
+    expect(finance).toContain("'/vencimientos/:repartidorId/:docId/detalle', verifyToken, requireFinanceRepartidorSelector");
+  });
+
+  test('chatbot reparto does not derive a fleet from commercial vendor scope', () => {
+    const authorization = read('src/chatbot/chatbot_authorization.js');
+    expect(authorization).toContain('userContext.repartidorCodes');
+    expect(authorization).toContain("requested.codes.includes('BOLA')");
+    expect(read('src/chatbot/llm-orchestrator.js')).toContain('server-authorized driver list');
+  });
+});
