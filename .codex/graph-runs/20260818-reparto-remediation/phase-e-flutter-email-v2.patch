diff --git a/test/features/repartidor/data/reparto_receipt_email_contract_test.dart b/test/features/repartidor/data/reparto_receipt_email_contract_test.dart
new file mode 100644
--- /dev/null
+++ b/test/features/repartidor/data/reparto_receipt_email_contract_test.dart
@@ -0,0 +1,16 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:gmp_app_mobilidad/features/repartidor/data/repartidor_data_service.dart';
+
+void main() {
+  test('receipt email requires sender and ledger acknowledgements', () {
+    expect(RepartoReceiptEmailResult.fromResponse(const {
+      'success': true, 'messageId': 'smtp-123', 'ledgerWritten': true,
+    }).delivered, isTrue);
+    expect(RepartoReceiptEmailResult.fromResponse(const {
+      'success': true, 'messageId': '', 'ledgerWritten': true,
+    }).delivered, isFalse);
+    expect(isValidRepartoReceiptEmailAddress(' client@gmp.es '), isTrue);
+    expect(isValidRepartoReceiptEmailAddress('client@gmp'), isFalse);
+  });
+}
