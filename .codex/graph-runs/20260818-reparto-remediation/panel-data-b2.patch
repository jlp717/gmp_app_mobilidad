+class DailyCollection {
+  DailyCollection({
+    required this.day,
+    required this.date,
+    required this.collectable,
+    required this.collected,
+    this.pending = 0,
+    this.collectionAvailability = 'COMPLETE',
+  });
+
+  factory DailyCollection.fromJson(Map<String, dynamic> json) {
+    return DailyCollection(
+      day: (json['day'] as int?) ?? 0,
+      date: (json['date'] as String?) ?? '',
+      collectable: ((json['collectable'] ?? 0) as num).toDouble(),
+      collected: ((json['collected'] ?? 0) as num).toDouble(),
+      pending: ((json['pending'] ?? 0) as num).toDouble(),
+      collectionAvailability:
+          (json['collectionAvailability'] as String?)?.toUpperCase() ??
+              'COMPLETE',
+    );
+  }
+  final int day;
+  final String date;
+  final double collectable;
+  final double collected;
+  final double pending;
+  final String collectionAvailability;
+}
+
+class DailyCollectionsResult {
+  DailyCollectionsResult({
+    required this.collectionAvailability,
+    required List<DailyCollection> daily,
+  }) : daily = List.unmodifiable(daily);
+
+  factory DailyCollectionsResult.fromJson(Map<String, dynamic> json) {
+    return DailyCollectionsResult(
+      collectionAvailability:
+          (json['collectionAvailability'] as String?)?.toUpperCase() ??
+              'COMPLETE',
+      daily: (json['daily'] as List? ?? const <dynamic>[])
+          .whereType<Map>()
+          .map((item) => DailyCollection.fromJson(Map<String, dynamic>.from(item)))
+          .toList(),
+    );
+  }
+
+  final String collectionAvailability;
+  final List<DailyCollection> daily;
+
+  bool get isPartial => collectionAvailability == 'PARTIAL';
+}
