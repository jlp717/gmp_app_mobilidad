diff --git a/backend/__tests__/reparto-finance-security-remediation.test.js b/backend/__tests__/reparto-finance-security-remediation.test.js
new file mode 100644
--- /dev/null
+++ b/backend/__tests__/reparto-finance-security-remediation.test.js
@@ -0,0 +1,69 @@
+'use strict';
+
+const router = require('../routes/repartidor-finanzas');
+const financeService = require('../services/repartidor-finance-service');
+
+describe('reparto finance remediation security contract', () => {
+  test.each([
+    ['', 'REPARTO_OWNER_REQUIRED'],
+    ['ALL', 'REPARTO_OWNER_REQUIRED'],
+    ['1,2', 'REPARTO_OWNER_REQUIRED'],
+  ])('concrete owner rejects %p before a repository call', (value, code) => {
+    expect(() => router.assertConcreteOwner(value)).toMatchObject({ code, statusCode: 422 });
+  });
+
+  test('repartidor cannot select another driver or a fleet', () => {
+    const req = { user: { role: 'REPARTIDOR', code: '7' } };
+    expect(() => router.authorizedFinanceSelection(req, '8')).toMatchObject({ statusCode: 403 });
+    expect(() => router.authorizedFinanceSelection(req, '7,8')).toMatchObject({ statusCode: 403 });
+  });
+
+  test('JEFE expands ALL only to the explicit authorized code list', () => {
+    const req = { user: { role: 'JEFE_VENTAS', authorizedRepartidorIds: ['30', '50', '70'] } };
+    expect(router.authorizedFinanceSelection(req, 'ALL')).toBe('30,50,70');
+    expect(() => router.authorizedFinanceSelection(req, '99')).toMatchObject({ statusCode: 403 });
+  });
+
+  test('commission ignores a tier below 30 percent', () => {
+    const result = financeService.calculateCommission({
+      deliveredAmount: 100, collectedAmount: 29.99,
+      tiers: [{ thresholdPct: 29, commissionPct: 99 }, { thresholdPct: 30, commissionPct: 10 }],
+    });
+    expect(result.commission).toBe(0);
+    expect(result.reached).toEqual([]);
+  });
+
+  test('commission starts at the 30 percent tier', () => {
+    const result = financeService.calculateCommission({
+      deliveredAmount: 100, collectedAmount: 50,
+      tiers: [
+        { thresholdPct: 30, commissionPct: 10 },
+        { thresholdPct: 50, commissionPct: 20 },
+        { thresholdPct: 70, commissionPct: 30 },
+      ],
+    });
+    expect(result.reached[0]).toMatchObject({ thresholdPct: 30, commission: 2 });
+  });
+});

