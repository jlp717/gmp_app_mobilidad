@@ -0,0 +1,42 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:gmp_app_mobilidad/features/repartidor/data/repartidor_data_service.dart';
+
+void main() {
+  group('RepartoReceiptEmailResult', () {
+    test('only acknowledges sender and ledger-backed delivery', () {
+      expect(
+        RepartoReceiptEmailResult.fromResponse(const {
+          'success': true,
+          'messageId': 'smtp-123',
+          'ledgerWritten': true,
+        }).delivered,
+        isTrue,
+      );
+
+      expect(
+        RepartoReceiptEmailResult.fromResponse(const {
+          'success': true,
+          'messageId': '',
+          'ledgerWritten': true,
+        }).delivered,
+        isFalse,
+      );
+      expect(
+        RepartoReceiptEmailResult.fromResponse(const {
+          'success': true,
+          'messageId': 'smtp-123',
+          'ledgerWritten': false,
+        }).delivered,
+        isFalse,
+      );
+    });
+
+    test('trims valid addresses and rejects malformed input before transport', () {
+      expect(isValidRepartoReceiptEmailAddress(' cliente@gmp.es '), isTrue);
+      expect(isValidRepartoReceiptEmailAddress('cliente@gmp'), isFalse);
+      expect(isValidRepartoReceiptEmailAddress('cliente @gmp.es'), isFalse);
+    });
+  });
+}
