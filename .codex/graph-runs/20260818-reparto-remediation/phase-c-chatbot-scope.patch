diff --git a/backend/__tests__/chatbot_reparto_scope.test.js b/backend/__tests__/chatbot_reparto_scope.test.js
new file mode 100644
--- /dev/null
+++ b/backend/__tests__/chatbot_reparto_scope.test.js
@@ -0,0 +1,54 @@
+'use strict';
+
+const { authorizeRepartoScope } = require('../src/chatbot/chatbot_authorization');
+
+describe('chatbot reparto scope authorization', () => {
+  test('REPARTIDOR can only query their own driver code', () => {
+    expect(authorizeRepartoScope({ role: 'REPARTIDOR', userCode: 'R1' }, 'R1'))
+      .toMatchObject({ allowed: true, driverCodes: ['R1'] });
+    expect(authorizeRepartoScope({ role: 'REPARTIDOR', userCode: 'R1' }, 'R2'))
+      .toMatchObject({ allowed: false, code: 'REPARTO_SCOPE_FORBIDDEN' });
+  });
+
+  test('BOLA and comma separated overrides are denied', () => {
+    const user = { role: 'JEFE_VENTAS', activeMode: 'REPARTIDOR', repartidorCodes: ['R1', 'R2'] };
+    expect(authorizeRepartoScope(user, 'BOLA')).toMatchObject({ allowed: false });
+    expect(authorizeRepartoScope(user, 'R1,R2')).toMatchObject({ allowed: false });
+  });
+
+  test('JEFE_VENTAS only receives the authenticated reparto scope in reparto mode', () => {
+    const user = { role: 'JEFE_VENTAS', activeMode: 'REPARTIDOR', repartidorCodes: ['R1', 'R2'] };
+    expect(authorizeRepartoScope(user, 'R2')).toMatchObject({ allowed: true, driverCodes: ['R2'] });
+    expect(authorizeRepartoScope(user, 'ALL')).toMatchObject({ allowed: true, driverCodes: ['R1', 'R2'] });
+    expect(authorizeRepartoScope({ ...user, activeMode: 'COMERCIAL' }, 'R1'))
+      .toMatchObject({ allowed: false, code: 'REPARTO_SCOPE_FORBIDDEN' });
+  });
+});
