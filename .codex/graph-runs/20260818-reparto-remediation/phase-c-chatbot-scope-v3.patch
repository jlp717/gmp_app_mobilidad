+        return {
+            sql: `AND ${column} = ?`,
+            params: safeCodes,
+        };
+    }
+    return {
+        sql: `AND ${column} IN (${safeCodes.map(() => '?').join(',')})`,
+        params: safeCodes,
+    };
+}
