diff --git a/backend/__tests__/repartidor-fleet-directory.test.js b/backend/__tests__/repartidor-fleet-directory.test.js
--- /dev/null	
+++ b/backend/__tests__/repartidor-fleet-directory.test.js	
@@ -1,0 +1,42 @@
+'use strict';
+
+const {
+  REPARTIDOR_FLEET_SQL,
+  canonicalRepartidorCode,
+  createRepartidorFleetDirectory,
+  normalizeFleetRows,
+} = require('../src/modules/auth/infrastructure/repartidor-fleet-directory');
+
+describe('signed repartidor fleet directory', () => {
+  test('uses one set-based VEH plus current-year OPP read and no mutation', () => {
+    expect(REPARTIDOR_FLEET_SQL).toMatch(/DSEDAC\.VEH/);
+    expect(REPARTIDOR_FLEET_SQL).toMatch(/DSEDAC\.OPP/);
+    expect(REPARTIDOR_FLEET_SQL).toMatch(/YEAR\(CURRENT_DATE\)/);
+    expect(REPARTIDOR_FLEET_SQL).not.toMatch(/\b(?:INSERT|UPDATE|DELETE|MERGE|CREATE|ALTER|DROP)\b/i);
+  });
+
+  test('canonicalizes numeric codes and excludes sentinels', () => {
+    expect(canonicalRepartidorCode('8')).toBe('08');
+    expect(normalizeFleetRows([
+      { CODE: '8', NAME: 'Ocho' },
+      { CODE: '08', NAME: 'Ocho definitivo' },
+      { CODE: '98', NAME: 'Jefe' },
+      { CODE: 'ZZ', NAME: 'ZZ Test' },
+    ])).toEqual([{ code: '08', name: 'Ocho definitivo' }]);
+  });
+
+  test('coalesces concurrent reads and caches for five minutes', async () => {
+    let now = 1_000;
+    const execute = jest.fn(async () => [{ CODE: '8', NAME: 'Ocho' }]);
+    const directory = createRepartidorFleetDirectory({ execute, now: () => now });
+    const [first, second] = await Promise.all([directory.list(), directory.list()]);
+    expect(first).toBe(second);
+    expect(execute).toHaveBeenCalledTimes(1);
+    now += 299_999;
+    await directory.list();
+    expect(execute).toHaveBeenCalledTimes(1);
+    now += 2;
+    await directory.list();
+    expect(execute).toHaveBeenCalledTimes(2);
+  });
+});

