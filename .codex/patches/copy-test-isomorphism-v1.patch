+  const type = source.dataType;
+  if (['CHAR', 'CHARACTER', 'VARCHAR', 'BINARY', 'VARBINARY', 'GRAPHIC', 'VARGRAPHIC', 'CLOB', 'DBCLOB', 'BLOB'].includes(type)) {
