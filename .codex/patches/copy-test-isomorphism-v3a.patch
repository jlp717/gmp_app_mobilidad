+
+const RUNTIME_INSERT_COLUMNS = Object.freeze({
+  'finance.cobros': Object.freeze([Object.freeze([
+    'CODIGOCLIENTEALBARAN', 'CODIGOCLIENTEFACTURA', 'CODIGOVENDEDOR',
+    'CODIGOVENDEDORCOBRO', 'TIPODOCUMENTO', 'ORIGENDOCUMENTO',
