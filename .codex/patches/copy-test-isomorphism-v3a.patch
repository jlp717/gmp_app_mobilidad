+    'MESCOBRO', 'ANOCOBRO', 'IDEMPOTENCY_TOKEN', 'PANTALLA_ORIGEN', 'OPERADOR',
+    'OBSERVACIONES', 'LIQUIDADO_SN', 'LIQUIDACION_TOKEN', 'NUMEROLIQUIDACION',
