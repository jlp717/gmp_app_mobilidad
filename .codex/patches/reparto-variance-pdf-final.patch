+'use strict';
+
+const { buildVariancePdfBuffer, buildVariancePdfModel } = require('../services/reparto-variance-pdf-service');
+
+function payload(overrides = {}) {
+  return {
+    documentId: 'ALB-2026-000042', documentoTipo: 'ALBARAN', fecha: '2026-08-18',
+    confirmedAt: '2026-08-18T10:25:30.000Z', clienteCodigo: '4300040696', clienteNombre: 'CLIENTE PRUEBA',
+    repartidorId: '08', repartidorNombre: 'REPARTIDOR PRUEBA', comercialCode: '57', comercialNombre: 'COMERCIAL PRUEBA',
+    deliveryStatus: 'PARCIAL', observaciones: 'Bulto deteriorado en recepción',
+    lineas: [
+      { codigoArticulo: 'ART-01', descripcion: 'POLLO ENTERO', cantidadPedida: 12, cantidadEntregada: 9, cantidadRechazada: 2, cantidadPendiente: 1, diff: -3, motivoDiferencia: 'ROTURA' },
+      { codigoArticulo: 'ART-02', descripcion: 'HUEVOS', cantidadPedida: 4, cantidadEntregada: 5, cantidadRechazada: 0, cantidadPendiente: 0, diff: 1, motivoDiferencia: 'UNIDAD EXTRA' },
+    ],
+    ...overrides,
+  };
+}
+
+describe('reparto-variance-pdf-service', () => {
+  test('preserva documento, conductor, marca temporal, líneas y totales auditables', async () => {
+    const model = buildVariancePdfModel(payload());
+    expect(model.documentId).toBe('ALB-2026-000042');
+    expect(model.repartidorId).toBe('08');
+    expect(model.confirmedAt).toBe('2026-08-18T10:25:30.000Z');
+    expect(model.lineas[0]).toEqual(expect.objectContaining({ cantidadPedida: 12, cantidadEntregada: 9, cantidadRechazada: 2, cantidadPendiente: 1, diff: -3, motivoDiferencia: 'ROTURA' }));
+    expect(model.totals).toEqual({ pedida: 16, entregada: 14, rechazada: 2, pendiente: 1, diff: -2 });
+    const pdf = await buildVariancePdfBuffer(payload());
+    expect(Buffer.isBuffer(pdf)).toBe(true);
+    expect(pdf.slice(0, 5).toString()).toBe('%PDF-');
+    expect(pdf.length).toBeGreaterThan(500);
+  });
+
+  test('rechaza una diferencia que no coincide con pedido y entregado', async () => {
+    await expect(buildVariancePdfBuffer(payload({ lineas: [{ cantidadPedida: 12, cantidadEntregada: 9, cantidadRechazada: 0, cantidadPendiente: 3, diff: -2 }] }))).rejects.toThrow('Diferencia de línea incoherente');
+  });
+
+  test('rechaza metadatos o cantidades no auditables', () => {
+    expect(() => buildVariancePdfModel(payload({ documentId: '  ' }))).toThrow('requiere documento');
+    expect(() => buildVariancePdfModel(payload({ lineas: [{ cantidadPedida: 'no-numero', cantidadEntregada: 1, cantidadRechazada: 0, cantidadPendiente: 0, diff: 0 }] }))).toThrow('Cantidad de diferencia inválida');
+  });
+});
