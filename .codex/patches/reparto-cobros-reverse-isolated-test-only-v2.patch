-  );
+async function reverseCobro({ idempotencyToken, reason, repartidorId, operador }) {
+  const runtime = assertFinanceRuntime();
+  if (runtime.tableSet !== 'isolated_test'
+      || !/^JAVIER\.TEST_[A-Z0-9_]+$/.test(String(runtime.tables.finance.cobros || '').toUpperCase())
+      || !/^JAVIER\.TEST_[A-Z0-9_]+$/.test(String(runtime.tables.finance.audit || '').toUpperCase())) {
+    throw new FinanceSchemaUnavailableError('La anulacion solo esta habilitada en TEST aislado');
+  }
+  const cobrosPort = createRepartoCobrosDb2Port({ runtime });
+  return withTransaction(async (conn) => {
+    await cobrosPort.assertCapabilities(conn);
+    return cobrosPort.forConnection(conn).reverseCobro({
+      idempotencyToken, reason, repartidorId, operador,
+    });
+  });
 }
diff --git a/backend/__tests__/reparto-cobros-reversal.test.js b/backend/__tests__/reparto-cobros-reversal.test.js
new file mode 100644
--- /dev/null
+++ b/backend/__tests__/reparto-cobros-reversal.test.js
@@ -0,0 +1,25 @@
+'use strict';
+
+// Contract tests require a DB2 double. Mandatory: first lock, race/replay,
+// audit+delete atomic rollback, ambiguous tombstone fail-closed, TEST-only
+// no-BEGIN preflight, foreign owner 403, liquidated 409, re-register 409.
+describe('TEST-only cobro reversal contract', () => {
+  test('requires isolated_test TEST table mapping before any transaction', () => {
+    const { createRepartoCobrosDb2Port } = require('../repositories/reparto-cobros-db2-port');
+    expect(() => createRepartoCobrosDb2Port({
+      runtime: { tableSet: 'production', writesEnabled: true, financeCapabilityApproved: true,
+        tables: { finance: { cobros: 'JAVIER.REPARTIDOR_COBROS', audit: 'JAVIER.REPARTIDOR_COBROS_AUDIT' } } },
+    })).toThrow(/autorizado|TEST/i);
+  });
+  test.todo('lock first; insert audit + delete exact one; rollback any failure');
+  test.todo('same token/reason replay 200; different reason 409; ambiguous tombstone fail closed');
+  test.todo('register sees tombstone 409; foreign owner 403; liquidated 409');
+});

