# 1) Secretos primero: gitleaks sobre lo staged (fallback local si no esta en PATH)
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --verbose --redact --no-banner || exit 1
elif [ -f ".claude/hooks/validate-secrets.mjs" ]; then
  node .claude/hooks/validate-secrets.mjs || exit 1
else
  echo "[pre-commit] AVISO: ni gitleaks ni fallback de secretos disponibles; instalalo con 'npx gitleaks'" >&2
fi

# 2) Formato/sintaxis solo si hay ficheros staged (<10s objetivo)
if [ -n "$(git diff --cached --name-only)" ] && [ -x "./node_modules/.bin/lint-staged" ]; then
  ./node_modules/.bin/lint-staged
elif [ -n "$(git diff --cached --name-only)" ]; then
  echo "[pre-commit] AVISO: falta tooling raiz. Ejecuta 'npm install' en la raiz del repo." >&2
fi
