# 1) Secretos primero: gitleaks sobre lo staged (fallback local si no esta en PATH)
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --verbose --redact --no-banner || exit 1
elif [ -f ".claude/hooks/validate-secrets.mjs" ]; then
  node .claude/hooks/validate-secrets.mjs || exit 1
else
  echo "[pre-commit] AVISO: ni gitleaks ni fallback de secretos disponibles" >&2
fi

# 2) Checks rapidos e identicos a lint-staged, invocados directo (<10s objetivo).
#    lint-staged sigue instalado y configurado (package.json) para uso manual/CI.

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

DART_FILES=$(echo "$STAGED" | grep '\.dart$' || true)
if [ -n "$DART_FILES" ]; then
  echo "$DART_FILES" | xargs dart format --output=none --set-exit-if-changed || {
    echo "[pre-commit] dart format fallo. Ejecuta: dart format ." >&2; exit 1; }
fi

JS_FILES=$(echo "$STAGED" | grep -E '\.(js|cjs|mjs)$' || true)
if [ -n "$JS_FILES" ]; then
  echo "$JS_FILES" | xargs -I{} node --check {} || {
    echo "[pre-commit] sintaxis JS invalida" >&2; exit 1; }
fi

exit 0
