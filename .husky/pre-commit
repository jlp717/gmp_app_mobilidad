#!/usr/bin/env bash
# Pre-commit hook for GMP App Movilidad (Flutter + Node.js backend)
# Installs automatically via husky or can be copied to .git/hooks/pre-commit

set -e

echo "🔒 Running pre-commit checks..."

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

FOUND=0

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
DART_FILES=$(echo "$STAGED_FILES" | grep -E "\.dart$" || true)
JS_FILES=$(echo "$STAGED_FILES" | grep -E "backend/.*\.js$" || true)

# ==========================================================================
# 1. Flutter: dart format check
# ==========================================================================
if [ -n "$DART_FILES" ]; then
  echo "  📝 Checking Dart formatting..."
  UNFORMATTED=$(dart format --output=none $DART_FILES 2>/dev/null || true)
  if [ -n "$UNFORMATTED" ]; then
    echo -e "${RED}❌ Unformatted Dart files:${NC}"
    echo "$UNFORMATTED"
    echo -e "${YELLOW}   Fix: dart format lib/ test/${NC}"
    FOUND=1
  else
    echo -e "${GREEN}   ✅ Dart formatting OK${NC}"
  fi
fi

# ==========================================================================
# 2. Flutter: flutter analyze (only if dart files changed)
# ==========================================================================
if [ -n "$DART_FILES" ]; then
  echo "  🔍 Running flutter analyze..."
  ANALYZE_OUTPUT=$(flutter analyze --no-pub 2>&1 || true)
  ERROR_COUNT=$(echo "$ANALYZE_OUTPUT" | grep -c "error -" || echo "0")
  if [ "$ERROR_COUNT" -gt 0 ]; then
    echo -e "${RED}❌ Flutter analyze found $ERROR_COUNT error(s):${NC}"
    echo "$ANALYZE_OUTPUT" | grep "error -"
    FOUND=1
  else
    echo -e "${GREEN}   ✅ Flutter analyze OK${NC}"
  fi
fi

# ==========================================================================
# 3. Backend: ESLint (only if JS files changed)
# ==========================================================================
if [ -n "$JS_FILES" ]; then
  echo "  🔍 Running backend lint..."
  cd backend
  LINT_OUTPUT=$(npx eslint --format compact ${JS_FILES#backend/} 2>&1 || true)
  if echo "$LINT_OUTPUT" | grep -q "problem"; then
    echo -e "${RED}❌ ESLint found issues:${NC}"
    echo "$LINT_OUTPUT"
    FOUND=1
  else
    echo -e "${GREEN}   ✅ Backend lint OK${NC}"
  fi
  cd ..
fi

# ==========================================================================
# 4. Security: Check for hardcoded secrets
# ==========================================================================
echo "  🔒 Scanning for hardcoded secrets..."
SECRET_PATTERNS=(
  "default-secret"
  "dev-access-secret"
  "dev-refresh-secret"
  "change-in-production"
  "your-secret-key"
  "your-secret-here"
  "supersecret"
  "password123"
  "API_KEY_HERE"
  "YOUR_API_KEY"
  "sk-live-"
  "pk-live-"
)

for pattern in "${SECRET_PATTERNS[@]}"; do
  MATCHES=$(echo "$STAGED_FILES" | xargs grep -l "$pattern" 2>/dev/null | grep -v ".git" || true)
  if [ -n "$MATCHES" ]; then
    echo -e "${RED}❌ Found secret pattern in staged files: $pattern${NC}"
    echo "$MATCHES"
    FOUND=1
  fi
done

# Check for .env files
ENV_FILES=$(echo "$STAGED_FILES" | grep -E "\.env$|\.env\." || true)
if [ -n "$ENV_FILES" ]; then
  echo -e "${RED}❌ Attempting to commit .env files:${NC}"
  echo "$ENV_FILES"
  FOUND=1
fi

# Check for private keys
if echo "$STAGED_FILES" | grep -qE "\.pem$|\.key$"; then
  echo -e "${RED}❌ Found private key files in commit${NC}"
  FOUND=1
fi

# ==========================================================================
# 5. Cloud provider token patterns
# ==========================================================================
CLOUD_PATTERNS=(
  "AKIA[0-9A-Z]{16}"
  "AIza[0-9A-Za-z\\-_]{35}"
  "ghp_[0-9a-zA-Z]{36}"
  "glpat-[0-9a-zA-Z\\-_]{20}"
)

for pattern in "${CLOUD_PATTERNS[@]}"; do
  if echo "$STAGED_FILES" | xargs grep -rE "$pattern" 2>/dev/null | grep -v ".git"; then
    echo -e "${RED}❌ Found cloud provider token pattern${NC}"
    FOUND=1
  fi
done

# ==========================================================================
# Result
# ==========================================================================
if [ "$FOUND" -eq 1 ]; then
  echo ""
  echo -e "${RED}🚫 PRE-COMMIT CHECKS FAILED${NC}"
  echo -e "${YELLOW}Fix the issues above before committing.${NC}"
  echo ""
  echo "To bypass (NOT RECOMMENDED):"
  echo "  git commit --no-verify"
  exit 1
fi

echo -e "${GREEN}✅ All pre-commit checks passed${NC}"
exit 0
