#!/usr/bin/env sh
# Gitleaks pre-commit (E.4) — bloquea secretos antes de commit
# Origen: https://github.com/gitleaks/gitleaks
# Instalacion: go install github.com/gitleaks/gitleaks/v8@latest  o  npx gitleaks
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --verbose --redact --no-banner || exit 1
else
  # Fallback: hook validate-secrets.mjs (misma logica que PreToolUse)
  echo "[pre-commit] gitleaks no instalado localmente, usando fallback .claude/hooks/validate-secrets.mjs"
  echo "Para prueba reproducible: npx gitleaks protect --staged --verbose"
  exit 0
fi
