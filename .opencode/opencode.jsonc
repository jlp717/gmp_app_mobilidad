// gmp_app_mobilidad â€” Flutter + Riverpod + Node.js + IBM DB2
// Override del proyecto sobre la config global ~/.config/opencode/opencode.jsonc
{
  "$schema": "https://opencode.ai/config.json",

  "model": "openai/gpt-5.5",
  "default_agent": "flutter-architect",
  "instructions": ["./.opencode/AGENTS.md"],

  // Timeout corto: ningun MCP debe colgar el arranque
  "experimental": {
    "mcp_timeout": 30000
  },

  // Activacion de MCPs. Definiciones vienen de la config global.
  "mcp": {
    // Compartidos (siempre on en ambos proyectos)
    "context7":            { "enabled": true },
    "sequential-thinking": { "enabled": true },
    "memory":              { "enabled": true },
    "filesystem":          { "enabled": true },
    "ddg-search":          { "enabled": true },
    "git":                 { "enabled": true },
    "github":              { "enabled": true },
    "firecrawl":           { "enabled": true },

    // Especificos Flutter â€” paquetes no verificados, off por defecto. Activar tras confirmar disponibilidad.
    "dart-flutter-mcp":    { "enabled": false },
    "pub-mcp":             { "enabled": false },
    "iflow-flutter":       { "enabled": false },

    // IBM DB2: requiere ODBC + Mapepire â€” off
    "ibm-db2-mcp":         { "enabled": false },

    // Sin credencial -> off
    "postgres":            { "enabled": false },
    "sentry":              { "enabled": false },

    // No relevantes para este proyecto Flutter
    "playwright":          { "enabled": false },
    "chrome-devtools":     { "enabled": false },
    "vercel":              { "enabled": false },
    "mcp-seo":             { "enabled": false },
    "web-quality-mcp":     { "enabled": false },
    "guardvibe":           { "enabled": false },
    "fetch":               { "enabled": false }
  }
}
