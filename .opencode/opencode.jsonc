// gmp_app_mobilidad — Flutter + Riverpod + Node.js + IBM DB2
// Override del proyecto sobre la config global ~/.config/opencode/opencode.jsonc
{
  "$schema": "https://opencode.ai/config.json",

  "model": "openai/gpt-5.5",
  "default_agent": "orchestrator",
  "instructions": ["./.opencode/AGENTS.md"],

  // Timeout 30s: safety net contra MCPs lentos
  "experimental": {
    "mcp_timeout": 30000
  },

  // MCPs activos en gmp_app_mobilidad.
  "mcp": {
    // Compartidos (siempre on)
    "context7":            { "enabled": true },
    "sequential-thinking": { "enabled": true },
    "memory":              { "enabled": true },
    "filesystem":          { "enabled": true },
    "ddg-search":          { "enabled": true },

    // Git y GitHub
    "git":                 { "enabled": true },
    "github":              { "enabled": true },

    // Web scraping / investigación
    "firecrawl":           { "enabled": true },

    // IBM DB2 for i — CRÍTICO para este proyecto
    "ibm-db2-mcp":         { "enabled": true },

    // Flutter/Dart MCPs
    "dart-flutter-mcp":    { "enabled": true },
    "pub-mcp":             { "enabled": true },
    "iflow-flutter":       { "enabled": true },

    // Deploy SSH al servidor productivo (192.168.1.230)
    "gmp-deploy-ssh":      { "enabled": true },

    // Sentry para monitorización de errores en prod
    "sentry":              { "enabled": true },

    // Time utilities
    "time":                { "enabled": true },

    // Code graph RAG — 99% token savings en sesiones largas
    "code-graph-rag":      { "enabled": true },

    // Serverless fetch
    "fetch":               { "enabled": true },

    // Playwright para testing E2E de flujos móviles
    "playwright":          { "enabled": true },

    // Excel para análisis de datos (reports, exports)
    "excel":               { "enabled": true },

    // No relevantes para este proyecto Flutter
    "chrome-devtools":     { "enabled": false },
    "vercel":              { "enabled": false },
    "mcp-seo":             { "enabled": false },
    "web-quality-mcp":     { "enabled": false },
    "guardvibe":           { "enabled": false },
    "postgres":            { "enabled": false },
    "brave-search":        { "enabled": false },
    "tavily":              { "enabled": false },
    "slack":               { "enabled": false },
    "serena":              { "enabled": true },
    "desktop-commander":   { "enabled": false },
    "sqlite":              { "enabled": false },
    "figma-context":       { "enabled": false },
    "cloudflare":          { "enabled": false }
  }
}