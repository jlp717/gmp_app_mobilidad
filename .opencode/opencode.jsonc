// gmp_app_mobilidad — Flutter + Riverpod + Node.js + IBM DB2
// Override del proyecto sobre la config global ~/.config/opencode/opencode.jsonc
// MCPs optimizados: solo los del camino critico diario activos.
// Los demas se activan on-demand cuando el orchestrator los necesita.
{
  "$schema": "https://opencode.ai/config.json",

  "model": "openai/gpt-5.5",
  "default_agent": "orchestrator",
  "instructions": ["./.opencode/AGENTS.md"],

  // Timeout 30s: safety net contra MCPs lentos
  "experimental": {
    "mcp_timeout": 30000
  },

  // MCPs activos en gmp_app_mobilidad.
  // CRITICOS DIARIOS: siempre on
  // ON-DEMAND: off por defecto, el orchestrator los activa cuando necesita
  "mcp": {
    // === CRITICOS DIARIOS (siempre on) ===
    "context7":            { "enabled": true },
    "sequential-thinking": { "enabled": true },
    "memory":              { "enabled": true },
    "filesystem":          { "enabled": true },
    "ddg-search":          { "enabled": true },
    "git":                 { "enabled": true },
    "github":              { "enabled": true },
    "firecrawl":           { "enabled": true },
    "ibm-db2-mcp":         { "enabled": true },
    "dart-flutter-mcp":    { "enabled": true },
    "pub-mcp":             { "enabled": true },
    "gmp-deploy-ssh":      { "enabled": true },
    "sentry":              { "enabled": true },
    "time":                { "enabled": true },
    "fetch":               { "enabled": true },

    // === ON-DEMAND (off por defecto, activar segun necesidad) ===
    // Code exploration profunda → activar con serena
    "serena":              { "enabled": false },
    // E2E testing → activar con playwright
    "playwright":          { "enabled": false },
    // Analisis de datos/reports → activar con excel
    "excel":               { "enabled": false },
    // Redundante con dart-flutter-mcp → solo si iflow aporta algo especifico
    "iflow-flutter":       { "enabled": false },
    // Token savings sesiones largas → activar si sesion >30 min
    "code-graph-rag":      { "enabled": false },

    // === NO RELEVANTES PARA ESTE PROYECTO FLUTTER ===
    "chrome-devtools":     { "enabled": false },
    "vercel":              { "enabled": false },
    "mcp-seo":             { "enabled": false },
    "web-quality-mcp":     { "enabled": false },
    "guardvibe":           { "enabled": false },
    "postgres":            { "enabled": false },
    "brave-search":        { "enabled": false },
    "tavily":              { "enabled": false },
    "slack":               { "enabled": false },
    "desktop-commander":   { "enabled": false },
    "sqlite":              { "enabled": false },
    "figma-context":       { "enabled": false },
    "cloudflare":          { "enabled": false },

    // === NUEVOS MCPs MAYO 2026 (on-demand) ===
    // Issue tracking con dependencias → beads init + beads-mcp (ACTIVO)
    "beads":               { "enabled": true },
    // Task management estructurado → requiere TASK_MASTER_API_KEY
    "task-master":         { "enabled": false },
    // IBM i MCP oficial (complementario) → requiere credenciales IBM i
    "ibmi-mcp-official":   { "enabled": false },
    // Spec-driven development CLI (ACTIVO)
    "openspec":            { "enabled": true },
    // Docs-to-skills converter (CLI, no MCP)
    "skill-seekers":       { "enabled": false }
  }
}
